chment:fixed;background-position:right;background-size:cover;background-image:url();position:relative" data-divider=""><div style="position:absolute;inset:0;background:rgba(0,0,0,0.5)"></div></div><section class="py-12 md:py-20 bg-[url(&#x27;/washi_background.webp&#x27;)]"><div class="w-full mx-auto px-4 max-w-3xl"><div class="text-center mb-8 md:mb-16"><div class="inline-block px-6 md:px-12"><p class="text-s md:text-sm text-gray-500 mb-1 md:mb-2">-ACCESS-</p><h2 class="text-2xl md:text-4xl font-bold">{{t $.Lang "home.access"}}</h2></div></div><div class="border bg-card text-card-foreground shadow-sm rounded-lg border-primary/20 mb-8"><div class="p-4 md:p-6"><div class="space-y-6"><div><h3 class="text-xl font-bold mb-2">{{t $.Lang "home.access_by_car"}}</h3><ul class="space-y-2 text-gray-600"><li>{{t $.Lang "home.about_2_hours_by_car_from_sapporo_about_40_minutes_from_the_yoichi_ic_on_the_d_expressway"}}</li><li>{{t $.Lang "home.about_1_hour_by_car_from_otaru"}}</li></ul></div><div><h3 class="text-xl font-bold mb-2">{{t $.Lang "home.parking_information"}}</h3><ul class="space-y-2 text-gray-600"><li>{{t $.Lang "home.free_parking_is_available_near_the_furubira_town_hall"}}</li><li>{{t $.Lang "home.parking_spaces_are_also_available_near_each_sightseeing_spot"}}</li></ul></div></div></div></div><div class="rounded-lg overflow-hidden shadow-lg"><iframe src="https://www.google.com/maps?q=%E3%80%92046-0192%20%E5%8C%97%E6%B5%B7%E9%81%93%E5%8F%A4%E5%B9%B3%E9%83%A1%E5%8F%A4%E5%B9%B3%E7%94%BA%E6%B5%9C%E7%94%BA50%E7%95%AA%E5%9C%B0%20%E5%8F%A4%E5%B9%B3%E7%94%BA%E5%BD%B9%E5%A0%B4&amp;output=embed&amp;hl=ja" title="古平町役場の地図" class="w-full h-96 object-cover" allowfullscreen="" loading="lazy"></iframe></div></div></section><div style="height:12rem;background-attachment:fixed;background-position:right;background-size:cover;background-image:url();position:relative" data-divider=""><div style="position:absolute;inset:0;background:rgba(0,0,0,0.5)"></div></div>{{template "footer-ja" .}}<