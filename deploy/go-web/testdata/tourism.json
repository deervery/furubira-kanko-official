  "routes": [
    {
      "has": [
        {
          "key": "lang",
          "type": "cookie",
          "value": "ja"
        }
      ],
      "headers": {
        "Location": "/ja"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/",
      "status": 307
    },
    {
      "has": [
        {
          "key": "lang",
          "type": "cookie",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/",
      "status": 307
    },
    {
      "has": [
        {
          "key": "accept-language",
          "type": "header",
          "value": "[eE][nN].*"
        }
      ],
      "headers": {
        "Location": "/en"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/",
      "status": 307
    },
    {
      "headers": {
        "Location": "/ja"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/",
      "status": 307
    },
    {
      "has": [
        {
          "key": "lang",
          "type": "cookie",
          "value": "ja"
        }
      ],
      "headers": {
        "Location": "/ja/$1"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/(spots|accommodations|dining|events|access|shopping|furusato|news(?:/.*)?)",
      "status": 307
    },
    {
      "has": [
        {
          "key": "lang",
          "type": "cookie",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en/$1"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/(spots|accommodations|dining|events|access|shopping|furusato|news(?:/.*)?)",
      "status": 307
    },
    {
      "has": [
        {
          "key": "accept-language",
          "type": "header",
          "value": "[eE][nN].*"
        }
      ],
      "headers": {
        "Location": "/en/$1"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/(spots|accommodations|dining|events|access|shopping|furusato|news(?:/.*)?)",
      "status": 307
    },
    {
      "headers": {
        "Location": "/ja/$1"
      },
      "methods": [
        "GET",
        "HEAD"
      ],
      "src": "/(spots|accommodations|dining|events|access|shopping|furusato|news(?:/.*)?)",
      "status": 307
    },
    {
      "dest": "/data/$1.json",
      "src": "/api/cms/(spots|restaurants|accommodations|events|shops)"
    },
    {
      "dest": "/data/news.json",
      "headers": {
        "Cache-Control": "no-store"
      },
      "src": "/api/news"
    },
    {
      "dest": "/retired-api.json",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "application/json; charset=utf-8"
      },
      "src": "/api/(?:chat(?:/.*)?|embedding|system_message)",
      "status": 410
    },
    {
      "continue": true,
      "headers": {
        "Cache-Control": "public,max-age=31536000,immutable"
      },
      "src": "/assets/.*"
    },
    {
      "handle": "filesystem"
    },
    {
      "dest": "/404.html",
      "src": "/.*",
      "status": 404
    }
  ],
  "version": 3
